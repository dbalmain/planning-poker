{
  "name": "planning-poker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "MINIFLARE_WORKERD_PATH=./scripts/workerd vite",
    "build": "vite build",
    "preview": "MINIFLARE_WORKERD_PATH=./scripts/workerd vite preview",
    "db:migrate": "MINIFLARE_WORKERD_PATH=./scripts/workerd wrangler d1 migrations apply planning-poker --local",
    "deploy": "npm run build && npm run deploy:config && npm run deploy:migrate && npm run deploy:worker",
    "deploy:config": "node scripts/inject-d1-id.mjs",
    "deploy:migrate": "wrangler d1 migrations apply DB --remote -c dist/planning_poker/wrangler.json",
    "deploy:worker": "wrangler deploy -c dist/planning_poker/wrangler.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.unit.config.ts && MINIFLARE_WORKERD_PATH=./scripts/workerd vitest run --config vitest.config.ts",
    "types": "wrangler types --include-runtime=false"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.28.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true,
    "sharp@0.35.2": true,
    "workerd@1.20251210.0": true,
    "workerd@1.20260811.1": true
  }
}
