{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "planning-poker",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	// planning-poker.davebalmain.me. Declaring the route here means the first
	// deploy creates the DNS record itself; there is nothing to click in the
	// dashboard. Requires the API token to hold Zone:DNS:Edit and
	// Zone:Workers Routes:Edit on davebalmain.me.
	"routes": [
		{
			"pattern": "planning-poker.davebalmain.me",
			"custom_domain": true,
		},
	],
	// The custom domain is the only entry point; no planning-poker.*.workers.dev.
	"workers_dev": false,
	"assets": {
		// No "directory" here on purpose: @cloudflare/vite-plugin sets it to the
		// client build output when it generates dist/planning_poker/wrangler.json.
		// Setting it by hand would make a bare `wrangler deploy` publish public/
		// — a single file — as the entire site.
		"not_found_handling": "single-page-application",
		// Keep these prefixes aligned with the route definitions in shared/routes.ts.
		"run_worker_first": [
			"/api/*",
			"/ws/*",
			"/healthz"
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "planning-poker",
			// "database_id" is deliberately absent: this repo is public, and a
			// committed id is wrong for anyone who forks it. Local dev and both
			// test suites use miniflare's local D1 and need no id at all. Remote
			// deploys get it from the D1_DATABASE_ID secret, injected into the
			// generated config by scripts/inject-d1-id.mjs — see .github/workflows/ci.yml.
			// (`wrangler d1 create` appends an id here automatically; delete it.)
			"migrations_dir": "migrations",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "Room"
			}
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Room"
			]
		}
	],
	"triggers": {
		"crons": [
			"0 4 * * *"
		],
	},
}
