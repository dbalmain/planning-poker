{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "planning-poker",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application",
		// Keep these prefixes aligned with the route definitions in shared/routes.ts.
		"run_worker_first": [
			"/api/*",
			"/ws/*",
			"/healthz"
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "planning-poker",
			// After `wrangler d1 create planning-poker`, paste the id here.
			// "database_id": "<id>",
			"migrations_dir": "migrations",
		},
		{
			"binding": "planning_poker",
			"database_name": "planning-poker",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "Room"
			}
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Room"
			]
		}
	],
	"triggers": {
		"crons": [
			"0 4 * * *"
		],
	},
}
